#!/bin/sh
# Wrapper so bar configs can call `sbs ...`. Symlink it into your PATH:
#   ln -s "$PWD/bin/sbs" ~/.local/bin/sbs
# Runs the TypeScript with nub (https://nubjs.com) when installed, else with
# Node >= 26 (type stripping is built in). SB_RUNTIME overrides both.
here=$(dirname "$(readlink -f "$0")")
if [ -n "$SB_RUNTIME" ]; then rt=$SB_RUNTIME
elif command -v nub >/dev/null 2>&1; then rt=nub
else rt=node
fi
exec $rt "$here/sbs.ts" "$@"
